# Optional runtime configuration. Append selected entries to .dev.vars locally,
# or configure them as deployment secrets/variables. Leave disabled until reviewed.

# Outbound replies stay disabled by default. Enabling this alone is insufficient:
# the store must also be enabled and have a verified, unexpired reply capability.
OUTBOUND_ENABLED=false

# Reply translation is independently disabled. Enabling it also requires the
# native Pi runtime binding, an enabled company budget and reviewed pricing.
TRANSLATION_ENABLED=false
NVAPI_KEY=
# Company Settings > AI Model supports one company-wide OpenAI-compatible connection.
# Provider keys use STORE_CREDENTIAL_KEYS, with a separate authenticated encryption domain.
# Common provider hosts are built in. Add exact trusted public gateway hosts (comma-separated),
# never wildcards, private hosts, IPs or full URLs. Redirects remain refused.
AI_MODEL_ALLOWED_HOSTS=
# JSON TranslationConfig: provider, model, modelConfigVersion, promptVersion,
# maxInputTokens, maxOutputTokens and pricing (version, currency, all four
# *MicrosPerMillion rates). No price is inferred; only verified free usage is 0.
# See docs/02-architecture.md section 15. Keep this blank until reviewed.
TRANSLATION_CONFIG_JSON=

# Internal autonomous reception has no separate deployment switch. A saved connection
# alone is insufficient: Company Settings > AI Model must include reviewed prices and
# execution limits, plus an explicitly enabled, usable budget and published automatic policy.
# Automatic customer replies additionally require explicit autoReply authorization;
# it defaults to false. AI_OUTBOUND_ENABLED below still gates sending.
# Automatic customer replies also require OUTBOUND_ENABLED and the store outbound permission.
# Keep disabled until reply quality and platform delivery acceptance. See architecture 7.31.
AI_OUTBOUND_ENABLED=false
# Production Support configuration: {"model": <TranslationConfig>, "maxGenerations": 1..8}.
# Use the supported NVIDIA model/version and reviewed prices; blank is unavailable, never free.
# This is separate from translation configuration. See architecture 7.19.
AI_RECEPTION_CONFIG_JSON=

# Knowledge retrieval is text-only: the published markdown body is stored in D1 and the
# assistant reads it through scoped knowledge tools. Migration 0071 adds SQLite FTS5
# trigram search, not semantic similarity. There is no embedding or paid indexing workflow.

# Model and Ozon credentials are not required for account and team workflows.
# Public self-service registration remains disabled; new accounts use installation or invitation.
