{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "dingbell-platform-probe",
  "workers_dev": true,
  "preview_urls": false,
  "compatibility_date": "2026-06-01",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [{ "name": "PROBE_STATE", "class_name": "PlatformProbeState" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["PlatformProbeState"] }],
  "r2_buckets": [{ "binding": "PROBE_BUCKET", "bucket_name": "dingbell-platform-probe" }],
  "queues": {
    "producers": [{ "binding": "PROBE_QUEUE", "queue": "dingbell-platform-probe" }],
    "consumers": [
      {
        "queue": "dingbell-platform-probe",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_retries": 2,
        "retry_delay": 0,
        "dead_letter_queue": "dingbell-platform-probe-dlq"
      },
      { "queue": "dingbell-platform-probe-dlq", "max_batch_size": 1, "max_batch_timeout": 1 }
    ]
  },
  "triggers": { "crons": [] }
}
