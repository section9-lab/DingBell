{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "dingbell-pi-portability-probe",
  "main": "cloudflare.ts",
  "compatibility_date": "2026-10-29",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      { "name": "SESSIONS", "class_name": "PortabilitySession" },
      { "name": "GATES", "class_name": "PortabilityGate" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["PortabilitySession", "PortabilityGate"] }
  ],
  "observability": { "enabled": false },
  "preview_urls": false
}
