{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "dingbell-identity-probe",
  "main": "src/index.ts",
  "workers_dev": true,
  "preview_urls": false,
  "compatibility_date": "2026-06-01",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [{
    "binding": "DB",
    "database_name": "dingbell-identity-probe-db",
    "database_id": "identity-local-only",
    "migrations_dir": "migrations"
  }]
}
