{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "dingbell",
  "main": "src/platform/cloudflare/worker.ts",
  "compatibility_date": "2026-06-01",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    // 这是本仓库的唯一生产部署配置（含真实 D1 ID）：对外发送与 AI 自动外发在此开启。
    // 本地默认 wrangler.jsonc 仍然保持 false，发布检查与本地 demo 不受影响。
    "OUTBOUND_ENABLED": "true",
    "AI_OUTBOUND_ENABLED": "true"
  },
  "durable_objects": {
    "bindings": [
      { "name": "PI_AGENT", "class_name": "PiAgentObject" },
      { "name": "STORE_COORDINATOR", "class_name": "StoreCoordinator" },
      { "name": "CONVERSATION_CONTROLLER", "class_name": "ConversationController" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["StoreCoordinator"] },
    { "tag": "v2", "new_sqlite_classes": ["ConversationController"] },
    { "tag": "v3", "new_sqlite_classes": ["FlueReplyPreviewAgent"] },
    { "tag": "v4", "new_sqlite_classes": ["FlueReplyTestAgent"] },
    { "tag": "v5", "new_sqlite_classes": ["FlueSupportAgent"] },
    { "tag": "v6", "new_sqlite_classes": ["PiAgentObject"] },
    { "tag": "v7", "renamed_classes": [
      { "from": "FlueReplyPreviewAgent", "to": "LegacyReplyPreviewArchive" },
      { "from": "FlueReplyTestAgent", "to": "LegacyReplyTestArchive" },
      { "from": "FlueSupportAgent", "to": "LegacySupportArchive" }
    ] }
  ],
  "triggers": { "crons": ["* * * * *"] },
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*", "/agents", "/agents/*", "/__probe", "/__probe/*", "/__internal", "/__internal/*"]
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "dingbell-db",
    "database_id": "524bc482-2689-4bac-9466-ee185b418599",
    "migrations_dir": "migrations"
  }]
}
