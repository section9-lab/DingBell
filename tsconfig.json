{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ESNext"],
    "types": ["node", "@cloudflare/workers-types"],
    "allowImportingTsExtensions": true,
    "paths": { "@/*": ["./src/web/*"] },
    "verbatimModuleSyntax": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["src", "tests", "probes", "*.config.ts"],
  "exclude": ["src/web"]
}
