{
  "name": "dingbell",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.14.0 <25"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "check:types": "tsc --noEmit && tsc --noEmit -p src/web/tsconfig.json",
    "test": "node --test --test-concurrency=4 tests/*.test.ts src/web/lib/*.test.ts probes/flue/app.test.ts",
    "test:web": "playwright test --config tests/e2e/playwright.config.ts",
    "probe:dev": "vite --config probes/flue/vite.config.ts --host 127.0.0.1",
    "probe:build": "vite build --config probes/flue/vite.config.ts",
    "test:flue": "node --test --test-concurrency=1 tests/integration/flue.test.ts",
    "test:identity": "node --test --test-concurrency=1 tests/integration/identity.test.ts",
    "test:application-identity": "node --test --test-concurrency=1 tests/integration/application-identity.test.ts",
    "test:sync": "node --test --test-concurrency=1 tests/integration/sync.test.ts",
    "test:control": "node --test --test-concurrency=1 tests/integration/conversation-control.test.ts tests/integration/conversation-reply.test.ts",
    "test:translation": "node --test --test-concurrency=1 tests/integration/reply-preview.test.ts",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "demo:local": "npm run db:migrate:local && npx -y node@24.14.0 scripts/create-local-demo.mjs",
    "db:check": "drizzle-kit check",
    "licenses:check": "node scripts/license-inventory.mjs",
    "licenses:inventory": "node scripts/license-inventory.mjs --write",
    "check:release": "npm run licenses:check && node scripts/check-release.mjs",
    "test:platform": "node --test --test-concurrency=1 tests/integration/platform.test.ts",
    "test:upgrade-local": "node --test --test-concurrency=1 tests/d1-backup-upgrade.test.ts tests/stores-credentials.test.ts tests/conversation-work-status-migration.test.ts tests/ai-send-contracts.test.ts tests/knowledge-vector-cleanup-migration.test.ts",
    "test:capacity-local": "node scripts/local-capacity-check.mjs",
    "test:knowledge-evaluation-local": "node --test --test-concurrency=1 tests/knowledge-evaluation.test.ts tests/knowledge-directory-capacity.test.ts",
    "check": "npm run check:types && npm test && npm run build && node --test tests/integration/build.test.ts"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@better-auth/drizzle-adapter": "1.7.7",
    "@earendil-works/pi-ai": "0.87.1",
    "@flue/runtime": "2.2.2",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource/noto-sans-sc": "5.3.0",
    "@json2csv/whatwg": "7.0.8",
    "@shadcn/react": "0.3.1",
    "@tanstack/react-query": "5.104.1",
    "@valibot/to-json-schema": "1.8.0",
    "better-auth": "1.7.7",
    "class-variance-authority": "0.7.1",
    "cn": "0.4.0",
    "csv-parse": "7.0.3",
    "drizzle-orm": "0.45.4",
    "eventsource-parser": "3.1.1",
    "hono": "4.13.13",
    "lucide-react": "1.54.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.89.0",
    "react-router": "8.4.0",
    "valibot": "1.5.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.49.0",
    "@cloudflare/workers-types": "5.20261008.1",
    "@flue/cli": "2.2.2",
    "@flue/vite": "2.2.2",
    "@playwright/test": "1.64.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "agents": "0.20.1",
    "auth": "1.7.7",
    "drizzle-kit": "0.31.11",
    "miniflare": "4.20260730.0",
    "shadcn": "4.21.4",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2",
    "vite": "8.1.2",
    "wrangler": "4.116.0"
  }
}
